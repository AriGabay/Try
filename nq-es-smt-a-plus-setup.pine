//@version=6
// =============================================================================
//  NQ/ES SMT A+ Setup  —  Full liquidity-driven setup engine (Pine Script v6)
// -----------------------------------------------------------------------------
//  Lifecycle managed end-to-end:
//    Liquidity Sweep -> SMT Divergence -> Displacement -> MSS / CISD
//    -> FVG / IFVG (entry zone) -> Retest -> Entry -> Stop / TP -> Result
//
//  Non-repainting design:
//    * Every setup transition is committed only on a CONFIRMED bar
//      (barstate.isconfirmed). Historical bars are processed once at close, so
//      what you back-test equals what you saw live.
//    * Pivots are acknowledged only AFTER their right-hand bars close.
//    * request.security() always uses barmerge.lookahead_off -> no future data.
//    * SMT alone is never an entry. An entry is marked only after the whole
//      chain completes AND price retests the entry zone.
//    * Works on an NQ chart (compares to ES) or an ES chart (compares to NQ).
//
//  Pine limitation note (spec section 26): "institutional order flow",
//  "true manipulation" and "market-maker intent" cannot be measured from OHLC.
//  This script models measurable PROXIES (sweeps, divergence, displacement,
//  structure shifts) and never claims to read intent.
// =============================================================================
indicator("NQ/ES SMT A+ Setup", "SMT A+",
     overlay          = true,
     max_lines_count  = 500,
     max_labels_count = 500,
     max_boxes_count  = 500,
     max_bars_back    = 5000)

// ─────────────────────────────────────────────────────────────────────────────
//  0.  STATE-MACHINE CONSTANTS
// ─────────────────────────────────────────────────────────────────────────────
const int ST_IDLE    = 0
const int ST_SWEPT   = 1
const int ST_SMT     = 2
const int ST_DISP    = 3
const int ST_SHIFT   = 4
const int ST_ZONE    = 5
const int ST_WAIT    = 6
const int ST_ENTRY   = 7
const int ST_INVALID = 8
const int ST_EXPIRED = 9

f_stateName(int s) =>
    switch s
        ST_IDLE    => "IDLE"
        ST_SWEPT   => "LIQUIDITY_SWEPT"
        ST_SMT     => "SMT_CONFIRMED"
        ST_DISP    => "DISPLACEMENT_CONFIRMED"
        ST_SHIFT   => "STRUCTURE_SHIFT_CONFIRMED"
        ST_ZONE    => "ENTRY_ZONE_CREATED"
        ST_WAIT    => "WAITING_FOR_RETEST"
        ST_ENTRY   => "ENTRY_TRIGGERED"
        ST_INVALID => "INVALIDATED"
        ST_EXPIRED => "EXPIRED"
        => "-"

// =============================================================================
//  1.  INPUTS
// =============================================================================
// -- 1a. Symbols --------------------------------------------------------------
gSym   = "1 · Symbols (SMT pair)"
inSym1 = input.symbol("CME_MINI:NQ1!", "Symbol 1 (index A)", group = gSym,
     tooltip = "First instrument of the SMT pair. Default NQ. Use MNQ1! for micros.")
inSym2 = input.symbol("CME_MINI:ES1!", "Symbol 2 (index B)", group = gSym,
     tooltip = "Second instrument of the SMT pair. Default ES. Use MES1! for micros.")
autoPair = input.bool(true, "Auto-detect comparison symbol from chart", group = gSym,
     tooltip = "ON: chart==Sym1 compares to Sym2 and vice-versa. OFF: chart always compared to Sym2.")

// -- 1b. SMT detection --------------------------------------------------------
gSmt = "2 · SMT detection"
smtMethod  = input.string("Swing", "SMT method", options = ["Swing", "Liquidity Level", "Both"], group = gSmt,
     tooltip = "Swing = compare confirmed swing pivots. Liquidity Level = compare which symbol sweeps a level. Both = either.")
pvtLeft    = input.int(3, "Pivot left bars",  minval = 1, group = gSmt, inline = "pv")
pvtRight   = input.int(3, "Pivot right bars", minval = 1, group = gSmt, inline = "pv",
     tooltip = "A pivot is acknowledged only after this many right bars close (non-repainting).")
smtMaxGap  = input.int(5, "Max bars between paired pivots", minval = 1, group = gSmt)
smtTolAtr  = input.float(0.05, "Min price deviation (x ATR)", minval = 0.0, step = 0.01, group = gSmt,
     tooltip = "A lower-low counts only if it is at least this many ATR below the prior low. Each symbol uses its OWN ATR.")
smtMaxAge  = input.int(60, "Max age of an SMT before it stops seeding (bars)", minval = 5, group = gSmt)

// -- 1c. Liquidity levels -----------------------------------------------------
gLiq        = "3 · Liquidity levels"
usePDHL     = input.bool(true, "Previous Day High / Low",   group = gLiq)
useAsiaLvl  = input.bool(true, "Asia High / Low",           group = gLiq)
useLonLvl   = input.bool(true, "London High / Low",         group = gLiq)
usePrevSess = input.bool(true, "Previous session High / Low", group = gLiq)
useEqual    = input.bool(true, "Equal Highs / Lows",        group = gLiq)
useSwingLvl = input.bool(true, "Recent swing High / Low",   group = gLiq)
eqTolAtr    = input.float(0.10, "Equal H/L tolerance (x ATR)", minval = 0.01, step = 0.01, group = gLiq)

// -- 1d. Liquidity sweep ------------------------------------------------------
gSwp        = "4 · Liquidity sweep"
sweepMode   = input.string("Wick", "Sweep definition",
     options = ["Wick", "Close+Reclaim", "Any break + displacement"], group = gSwp,
     tooltip = "Wick: wick pierces the level, candle closes back inside. Close+Reclaim: body may close through but price must reclaim within N bars. Any: any break, provided displacement follows.")
reclaimBars = input.int(3, "Reclaim window (bars) for Close+Reclaim", minval = 1, group = gSwp)

// -- 1e. HTF bias -------------------------------------------------------------
gBias       = "5 · HTF bias"
biasMethod  = input.string("EMA", "Bias method",
     options = ["EMA", "Market Structure", "Premium/Discount", "Manual"], group = gBias)
biasTF1     = input.timeframe("15",  "Bias timeframe 1 (mandatory)", group = gBias)
biasTF2     = input.timeframe("60",  "Bias timeframe 2 (mandatory)", group = gBias)
biasTF3     = input.timeframe("240", "Bias timeframe 3 (bonus)",     group = gBias)
biasCombine = input.string("TF1 & TF2 must agree (TF3 bonus)", "Bias agreement rule",
     options = ["TF1 & TF2 must agree (TF3 bonus)", "Majority of the three", "Only TF1 decides"], group = gBias)
manualBias  = input.string("Neutral", "Manual bias", options = ["Bullish", "Bearish", "Neutral"], group = gBias)
biasEmaFast = input.int(50,  "Bias EMA fast", minval = 1, group = gBias, inline = "be")
biasEmaSlow = input.int(200, "Bias EMA slow", minval = 1, group = gBias, inline = "be")

// -- 1f. Displacement ---------------------------------------------------------
gDisp        = "6 · Displacement"
atrLen       = input.int(14, "ATR length", minval = 1, group = gDisp)
dispBodyAtr  = input.float(0.8, "Min body (x ATR)", minval = 0.1, step = 0.1, group = gDisp)
dispAvgLook  = input.int(10, "Average-body lookback", minval = 1, group = gDisp)
dispBodyMult = input.float(1.5, "Body strength (x avg body)", minval = 1.0, step = 0.1, group = gDisp)
dispClosePct = input.float(0.5, "Min close position in bar range", minval = 0.1, maxval = 1.0, step = 0.05, group = gDisp)
maxSmtToDisp = input.int(5, "Max bars: SMT -> Displacement", minval = 1, group = gDisp)

// -- 1g. Structure shift (MSS / CISD) -----------------------------------------
gStr        = "7 · Structure shift (MSS / CISD)"
intLeft     = input.int(2, "Internal pivot left",  minval = 1, group = gStr, inline = "ip")
intRight    = input.int(2, "Internal pivot right", minval = 1, group = gStr, inline = "ip")
mssReqClose = input.bool(true, "MSS requires candle CLOSE beyond structure", group = gStr)
maxDispToMss= input.int(5, "Max bars: Displacement -> MSS/CISD", minval = 1, group = gStr)
structNeed  = input.string("MSS or CISD", "Structure requirement",
     options = ["MSS or CISD", "MSS only", "CISD only", "Both MSS and CISD"], group = gStr)

// -- 1h. FVG / IFVG -----------------------------------------------------------
gFvg          = "8 · FVG / IFVG"
fvgMinAtr     = input.float(0.10, "Min FVG size (x ATR)", minval = 0.0, step = 0.01, group = gFvg)
fvgMinTicks   = input.int(0, "Min FVG size (ticks, 0 = off)", minval = 0, group = gFvg)
fvgMaxAge     = input.int(200, "Max FVG age (bars)", minval = 10, group = gFvg)
fvgFromDisp   = input.bool(true, "Entry zone only from displacement FVG/IFVG", group = gFvg)
ifvgFullClose = input.bool(true, "IFVG requires full close through the gap", group = gFvg)
entryZoneMode = input.string("Midpoint (50%)", "Entry inside the zone",
     options = ["Midpoint (50%)", "Proximal", "Distal"], group = gFvg)

// -- 1i. Setup timing ---------------------------------------------------------
gSM           = "9 · Setup timing"
maxSweepToSmt = input.int(3, "Max bars: Sweep <-> SMT", minval = 0, group = gSM)
maxWaitRetest = input.int(15, "Max bars waiting for retest", minval = 1, group = gSM)
setupMaxAge   = input.int(40, "Max total setup age before expiry (bars)", minval = 5, group = gSM)
cooldownBars  = input.int(20, "Cooldown after a setup closes (bars)", minval = 0, group = gSM)
allowReentry  = input.bool(false, "Allow one re-entry per SMT structure", group = gSM)

// -- 1j. Stop loss ------------------------------------------------------------
gStop      = "10 · Stop loss"
stopMethod = input.string("Beyond sweep", "Stop method",
     options = ["Beyond sweep", "Beyond swing", "Beyond zone", "Beyond swept level"], group = gStop)
stopBufAtr = input.float(0.10, "Stop buffer (x ATR)", minval = 0.0, step = 0.05, group = gStop)

// -- 1k. Take profit ----------------------------------------------------------
gTp     = "11 · Take profit"
tgtMode = input.string("Liquidity then RR", "Target selection",
     options = ["Liquidity then RR", "Fixed RR only"], group = gTp)
minRR    = input.float(2.0, "Minimum RR", minval = 0.5, step = 0.1, group = gTp)
targetRR = input.float(3.0, "Target RR",  minval = 0.5, step = 0.1, group = gTp)
maxRRcap = input.float(6.0, "Max RR (cap)", minval = 1.0, step = 0.5, group = gTp)
showTP1  = input.bool(true, "Show TP1 (= Minimum RR)", group = gTp, inline = "tp")
showTP2  = input.bool(true, "Show TP2 (main target)",  group = gTp, inline = "tp")

// -- 1l. Scoring & mode -------------------------------------------------------
gGrade       = "12 · Scoring & mode"
tradeMode    = input.string("Strict", "Mode", options = ["Strict", "Flexible"], group = gGrade,
     tooltip = "Strict: only fully-qualified A+ setups are shown. Flexible: A / B shown too.")
minAplus     = input.int(85, "Min score for A+", minval = 1, maxval = 100, group = gGrade)
minAscore    = input.int(75, "Min score for A",  minval = 1, maxval = 100, group = gGrade)
minBscore    = input.int(60, "Min score for B",  minval = 1, maxval = 100, group = gGrade)
flexMinScore = input.int(60, "Flexible: minimum score to display", minval = 1, maxval = 100, group = gGrade)
showB        = input.bool(true,  "Show B setups (warning only)", group = gGrade)
showC        = input.bool(false, "Show C setups (debug only)",   group = gGrade)

// -- 1m. Sessions (New York time) ---------------------------------------------
gSess   = "13 · Sessions — New York time"
sessTZ  = input.string("America/New_York", "Session timezone", group = gSess,
     tooltip = "Use an IANA name so Daylight Saving Time is handled automatically. Never hard-code UTC.")
useAsiaS = input.bool(true, "Asia",      inline = "z1", group = gSess)
sAsia    = input.session("2000-0000", "", inline = "z1", group = gSess)
useLonS  = input.bool(true, "London KZ", inline = "z2", group = gSess)
sLon     = input.session("0200-0500", "", inline = "z2", group = gSess)
useNYAM  = input.bool(true, "NY AM KZ",  inline = "z3", group = gSess)
sNYAM    = input.session("0830-1100", "", inline = "z3", group = gSess)
useNYPM  = input.bool(true, "NY PM",     inline = "z4", group = gSess)
sNYPM    = input.session("1330-1600", "", inline = "z4", group = gSess)
tradeSessions = input.string("NY AM + London", "Setups allowed in",
     options = ["NY AM only", "NY PM only", "London only", "NY AM + London", "All enabled sessions"], group = gSess)

// -- 1n. Display --------------------------------------------------------------
gShow          = "14 · Display"
showLevels     = input.bool(true, "Liquidity level lines", group = gShow)
showSweep      = input.bool(true, "Sweep markers",         group = gShow)
showSmtLine    = input.bool(true, "SMT connector + label", group = gShow)
showStruct     = input.bool(true, "MSS / CISD levels",     group = gShow)
showZones      = input.bool(true, "FVG / IFVG boxes",      group = gShow)
showTrade      = input.bool(true, "Entry / Stop / TP lines", group = gShow)
showScoreLbl   = input.bool(true, "Setup score label",     group = gShow)
showBg         = input.bool(true, "Session background",    group = gShow)
maxSetupsDrawn = input.int(6, "Max setups kept on chart", minval = 1, maxval = 30, group = gShow)

// -- 1o. Dashboard ------------------------------------------------------------
gDash     = "15 · Dashboard"
showDash  = input.bool(true, "Show dashboard", group = gDash)
dashPos   = input.string("Top Right", "Position",
     options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right"], group = gDash)
debugMode = input.bool(false, "Debug rows (score breakdown + reject reason)", group = gDash)

// =============================================================================
//  2.  SMALL UTILITIES
// =============================================================================
f_pos(string p) =>
    switch p
        "Top Right"    => position.top_right
        "Top Left"     => position.top_left
        "Bottom Right" => position.bottom_right
        "Bottom Left"  => position.bottom_left
        => position.middle_right

f_px(float p) =>
    na(p) ? "-" : str.tostring(math.round_to_mintick(p))

// plain root, e.g. "CME_MINI:ES1!" -> "ES", "MES1!" -> "MES"
f_root(string s) =>
    parts = str.split(s, ":")
    tail  = array.size(parts) > 0 ? array.get(parts, array.size(parts) - 1) : s
    str.replace_all(str.replace_all(tail, "1!", ""), "!", "")

// =============================================================================
//  3.  COMPARISON SYMBOL RESOLUTION  (works on either NQ or ES chart)
// =============================================================================
root1       = f_root(inSym1)
root2       = f_root(inSym2)
chartIsSym1 = str.contains(syminfo.root, root1)
chartIsSym2 = str.contains(syminfo.root, root2)
compSym     = not autoPair ? inSym2 : chartIsSym1 ? inSym2 : chartIsSym2 ? inSym1 : inSym2
compName    = f_root(compSym)

// =============================================================================
//  4.  ATR + PIVOTS (chart symbol)
// =============================================================================
atr    = ta.atr(atrLen)
smtTol = nz(atr) * smtTolAtr

phVal = ta.pivothigh(high, pvtLeft, pvtRight)
plVal = ta.pivotlow(low,  pvtLeft, pvtRight)
newPH = not na(phVal)
newPL = not na(plVal)

var float lastSwingHigh = na
var int   lastSwingHighBar = na
var float lastSwingLow  = na
var int   lastSwingLowBar = na
if newPH
    lastSwingHigh    := phVal
    lastSwingHighBar := bar_index - pvtRight
if newPL
    lastSwingLow    := plVal
    lastSwingLowBar := bar_index - pvtRight

intPH = ta.pivothigh(high, intLeft, intRight)
intPL = ta.pivotlow(low,  intLeft, intRight)
var float lastIntHigh = na
var float lastIntLow  = na
if not na(intPH)
    lastIntHigh := intPH
if not na(intPL)
    lastIntLow := intPL

// =============================================================================
//  5.  SESSION ENGINE (New York time, DST-safe)
// =============================================================================
inAsia = useAsiaS and not na(time(timeframe.period, sAsia, sessTZ))
inLon  = useLonS  and not na(time(timeframe.period, sLon,  sessTZ))
inNYAM = useNYAM  and not na(time(timeframe.period, sNYAM, sessTZ))
inNYPM = useNYPM  and not na(time(timeframe.period, sNYPM, sessTZ))

sessId = inNYAM ? 3 : inNYPM ? 4 : inLon ? 2 : inAsia ? 1 : 0
f_sessName(int s) =>
    s == 1 ? "Asia" : s == 2 ? "London" : s == 3 ? "NY AM" : s == 4 ? "NY PM" : "-"

sessScore = (inNYAM or inNYPM) ? 5 : inLon ? 4 : inAsia ? 2 : 0

inActiveSession = switch tradeSessions
    "NY AM only"     => inNYAM
    "NY PM only"     => inNYPM
    "London only"    => inLon
    "NY AM + London" => inNYAM or inLon
    => inNYAM or inNYPM or inLon or inAsia

// =============================================================================
//  6.  LIQUIDITY LEVELS
// -----------------------------------------------------------------------------
//  f_sessionLevels() is fully self-contained so it can be evaluated for the
//  comparison symbol through request.security(). Returns the completed Asia and
//  London ranges plus the previous completed session range. No nested security.
// =============================================================================
f_sessionLevels() =>
    aIn = not na(time(timeframe.period, sAsia, sessTZ))
    lIn = not na(time(timeframe.period, sLon,  sessTZ))
    nIn = not na(time(timeframe.period, sNYAM, sessTZ))
    pIn = not na(time(timeframe.period, sNYPM, sessTZ))
    var float aHiRun = na
    var float aLoRun = na
    var float aHi = na
    var float aLo = na
    if aIn
        aHiRun := (na(aHiRun) or not aIn[1]) ? high : math.max(aHiRun, high)
        aLoRun := (na(aLoRun) or not aIn[1]) ? low  : math.min(aLoRun, low)
    if aIn[1] and not aIn
        aHi := aHiRun
        aLo := aLoRun
    var float lHiRun = na
    var float lLoRun = na
    var float lHi = na
    var float lLo = na
    if lIn
        lHiRun := (na(lHiRun) or not lIn[1]) ? high : math.max(lHiRun, high)
        lLoRun := (na(lLoRun) or not lIn[1]) ? low  : math.min(lLoRun, low)
    if lIn[1] and not lIn
        lHi := lHiRun
        lLo := lLoRun
    sid = nIn ? 3 : pIn ? 4 : lIn ? 2 : aIn ? 1 : 0
    var float sHiRun = na
    var float sLoRun = na
    var float pHi = na
    var float pLo = na
    sChg = sid != sid[1]
    if sid != 0
        sHiRun := (sChg or na(sHiRun)) ? high : math.max(sHiRun, high)
        sLoRun := (sChg or na(sLoRun)) ? low  : math.min(sLoRun, low)
    if sChg and sid[1] != 0
        pHi := sHiRun[1]
        pLo := sLoRun[1]
    [aHi, aLo, lHi, lLo, pHi, pLo]

[asiaH, asiaL, lonH, lonL, prevSessH, prevSessL] = f_sessionLevels()

// Previous-day high / low (non-repainting: [1] + lookahead_off).
[pdh, pdl] = request.security(syminfo.tickerid, "D", [high[1], low[1]],
     lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off)

// Equal highs / lows (two consecutive pivots within tolerance).
var float prevPHv = na
var float lastPHv = na
var float prevPLv = na
var float lastPLv = na
var float eqHigh = na
var float eqLow  = na
eqTol = nz(atr) * eqTolAtr
if newPH
    prevPHv := lastPHv
    lastPHv := phVal
    if not na(prevPHv) and math.abs(lastPHv - prevPHv) <= eqTol
        eqHigh := math.max(lastPHv, prevPHv)
if newPL
    prevPLv := lastPLv
    lastPLv := plVal
    if not na(prevPLv) and math.abs(lastPLv - prevPLv) <= eqTol
        eqLow := math.min(lastPLv, prevPLv)

// =============================================================================
//  7.  COMPARISON SYMBOL DATA (lookahead_off everywhere)
// =============================================================================
[cO, cH, cL, cC, cATR] = request.security(compSym, timeframe.period,
     [open, high, low, close, ta.atr(atrLen)], lookahead = barmerge.lookahead_off)
[cAsiaH, cAsiaL, cLonH, cLonL, cPrevSH, cPrevSL] = request.security(compSym, timeframe.period,
     f_sessionLevels(), lookahead = barmerge.lookahead_off)
[cPDH, cPDL] = request.security(compSym, "D", [high[1], low[1]],
     lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off)
compTol = nz(cATR) * smtTolAtr

// =============================================================================
//  8.  SMT DIVERGENCE
// -----------------------------------------------------------------------------
//  Method 1 (Swing): chart pivots are timing anchors; the comparison symbol is
//  sampled on the SAME bar and we compare who made the new extreme. Fully
//  non-repainting (pivot known only pvtRight bars later). Sampling the partner
//  at the anchor bar is an accepted approximation for tightly-correlated
//  NQ/ES (spec section 26).
// =============================================================================
var float pChartPL = na
var float pCompPL = na
var int   pPLbar = na
var float pChartPH = na
var float pCompPH = na
var int   pPHbar = na

bool   bullSMT = false
bool   bearSMT = false
string smtStrong = ""
int    smtPvtBar = na

if (smtMethod == "Swing" or smtMethod == "Both") and newPL
    curChartPL = plVal
    curCompPL  = cL[pvtRight]
    if not na(pChartPL) and not na(pCompPL) and not na(curCompPL) and (bar_index - pvtRight - nz(pPLbar, bar_index)) <= smtMaxGap * 3
        chartLL = curChartPL < pChartPL - smtTol
        compLL  = curCompPL  < pCompPL  - compTol
        if chartLL != compLL
            bullSMT   := true
            smtStrong := chartLL ? compName : syminfo.root
            smtPvtBar := bar_index - pvtRight
    pChartPL := curChartPL
    pCompPL  := curCompPL
    pPLbar   := bar_index - pvtRight

if (smtMethod == "Swing" or smtMethod == "Both") and newPH
    curChartPH = phVal
    curCompPH  = cH[pvtRight]
    if not na(pChartPH) and not na(pCompPH) and not na(curCompPH) and (bar_index - pvtRight - nz(pPHbar, bar_index)) <= smtMaxGap * 3
        chartHH = curChartPH > pChartPH + smtTol
        compHH  = curCompPH  > pCompPH  + compTol
        if chartHH != compHH
            bearSMT   := true
            smtStrong := chartHH ? compName : syminfo.root
            smtPvtBar := bar_index - pvtRight
    pChartPH := curChartPH
    pCompPH  := curCompPH
    pPHbar   := bar_index - pvtRight

// Method 2 (Liquidity Level): one symbol sweeps a level, the partner does not
// sweep its OWN same-category level (XOR).
f_bullLvlSMT(float chLvl, float cmpLvl) =>
    chS  = not na(chLvl)  and low < chLvl  and close > chLvl
    cmpS = not na(cmpLvl) and cL  < cmpLvl and cC    > cmpLvl
    chS != cmpS and (chS or cmpS)
f_bearLvlSMT(float chLvl, float cmpLvl) =>
    chS  = not na(chLvl)  and high > chLvl  and close < chLvl
    cmpS = not na(cmpLvl) and cH   > cmpLvl and cC    < cmpLvl
    chS != cmpS and (chS or cmpS)

if smtMethod == "Liquidity Level" or smtMethod == "Both"
    bLo = (usePDHL and f_bullLvlSMT(pdl, cPDL)) or (useAsiaLvl and f_bullLvlSMT(asiaL, cAsiaL)) or (useLonLvl and f_bullLvlSMT(lonL, cLonL)) or (usePrevSess and f_bullLvlSMT(prevSessL, cPrevSL))
    bHi = (usePDHL and f_bearLvlSMT(pdh, cPDH)) or (useAsiaLvl and f_bearLvlSMT(asiaH, cAsiaH)) or (useLonLvl and f_bearLvlSMT(lonH, cLonH)) or (usePrevSess and f_bearLvlSMT(prevSessH, cPrevSH))
    if bLo
        bullSMT := true
        smtPvtBar := nz(smtPvtBar, bar_index)
        smtStrong := smtStrong == "" ? compName : smtStrong
    if bHi
        bearSMT := true
        smtPvtBar := nz(smtPvtBar, bar_index)
        smtStrong := smtStrong == "" ? compName : smtStrong

// =============================================================================
//  9.  RANKED LIQUIDITY LEVELS + SWEEP DETECTION
// -----------------------------------------------------------------------------
//  Rank (spec section 15 - Liquidity Location): PDH/PDL 15, Asia 13, London 11,
//  Equal 10, significant/prev-session swing 8, small swing 4.
// =============================================================================
var lowVals  = array.new<float>()
var lowNames = array.new<string>()
var lowRanks = array.new<int>()
var hiVals   = array.new<float>()
var hiNames  = array.new<string>()
var hiRanks  = array.new<int>()
array.clear(lowVals)
array.clear(lowNames)
array.clear(lowRanks)
array.clear(hiVals)
array.clear(hiNames)
array.clear(hiRanks)

f_addLow(bool use, float v, string n, int r) =>
    if use and not na(v)
        array.push(lowVals, v)
        array.push(lowNames, n)
        array.push(lowRanks, r)
f_addHigh(bool use, float v, string n, int r) =>
    if use and not na(v)
        array.push(hiVals, v)
        array.push(hiNames, n)
        array.push(hiRanks, r)

f_addLow(usePDHL, pdl, "PDL", 15)
f_addHigh(usePDHL, pdh, "PDH", 15)
f_addLow(useAsiaLvl, asiaL, "Asia Low", 13)
f_addHigh(useAsiaLvl, asiaH, "Asia High", 13)
f_addLow(useLonLvl, lonL, "London Low", 11)
f_addHigh(useLonLvl, lonH, "London High", 11)
f_addLow(useEqual, eqLow, "Equal Lows", 10)
f_addHigh(useEqual, eqHigh, "Equal Highs", 10)
f_addLow(usePrevSess, prevSessL, "Prev-Sess Low", 8)
f_addHigh(usePrevSess, prevSessH, "Prev-Sess High", 8)
f_addLow(useSwingLvl, lastSwingLow, "Swing Low", 8)
f_addHigh(useSwingLvl, lastSwingHigh, "Swing High", 8)

// Pending body-break trackers (Close+Reclaim mode).
var float pendBullLvl = na
var string pendBullName = ""
var int   pendBullRank = 0
var int   pendBullBar = na
var float pendBullExt = na
var float pendBearLvl = na
var string pendBearName = ""
var int   pendBearRank = 0
var int   pendBearBar = na
var float pendBearExt = na

float bswV = na
string bswN = ""
int    bswR = 0
float  bswExt = na
float  hswV = na
string hswN = ""
int    hswR = 0
float  hswExt = na

// --- bullish sweep of LOW levels ---
if sweepMode == "Close+Reclaim" and not na(pendBullLvl)
    if (bar_index - pendBullBar) > reclaimBars
        pendBullLvl := na
    else if close > pendBullLvl
        bswV := pendBullLvl
        bswN := pendBullName
        bswR := pendBullRank
        bswExt := pendBullExt
        pendBullLvl := na
if array.size(lowVals) > 0 and na(bswV)
    for i = 0 to array.size(lowVals) - 1
        lv = array.get(lowVals, i)
        rk = array.get(lowRanks, i)
        nm = array.get(lowNames, i)
        wick = low < lv and close > lv
        if sweepMode == "Wick" and wick
            if na(bswV) or rk > bswR
                bswV := lv
                bswN := nm
                bswR := rk
                bswExt := low
        else if sweepMode == "Any break + displacement" and low < lv
            if na(bswV) or rk > bswR
                bswV := lv
                bswN := nm
                bswR := rk
                bswExt := low
        else if sweepMode == "Close+Reclaim"
            if wick
                if na(bswV) or rk > bswR
                    bswV := lv
                    bswN := nm
                    bswR := rk
                    bswExt := low
            else if low < lv and close < lv
                if na(pendBullLvl) or rk > pendBullRank
                    pendBullLvl := lv
                    pendBullName := nm
                    pendBullRank := rk
                    pendBullBar := bar_index
                    pendBullExt := low

// --- bearish sweep of HIGH levels ---
if sweepMode == "Close+Reclaim" and not na(pendBearLvl)
    if (bar_index - pendBearBar) > reclaimBars
        pendBearLvl := na
    else if close < pendBearLvl
        hswV := pendBearLvl
        hswN := pendBearName
        hswR := pendBearRank
        hswExt := pendBearExt
        pendBearLvl := na
if array.size(hiVals) > 0 and na(hswV)
    for i = 0 to array.size(hiVals) - 1
        lv = array.get(hiVals, i)
        rk = array.get(hiRanks, i)
        nm = array.get(hiNames, i)
        wick = high > lv and close < lv
        if sweepMode == "Wick" and wick
            if na(hswV) or rk > hswR
                hswV := lv
                hswN := nm
                hswR := rk
                hswExt := high
        else if sweepMode == "Any break + displacement" and high > lv
            if na(hswV) or rk > hswR
                hswV := lv
                hswN := nm
                hswR := rk
                hswExt := high
        else if sweepMode == "Close+Reclaim"
            if wick
                if na(hswV) or rk > hswR
                    hswV := lv
                    hswN := nm
                    hswR := rk
                    hswExt := high
            else if high > lv and close > lv
                if na(pendBearLvl) or rk > pendBearRank
                    pendBearLvl := lv
                    pendBearName := nm
                    pendBearRank := rk
                    pendBearBar := bar_index
                    pendBearExt := high

bullSweep = not na(bswV)
bearSweep = not na(hswV)
sweepQualPts = sweepMode == "Wick" ? 10 : sweepMode == "Close+Reclaim" ? 7 : 3

// =============================================================================
// 10.  DISPLACEMENT
// =============================================================================
body     = math.abs(close - open)
avgBody  = ta.sma(body, dispAvgLook)
volSma20 = ta.sma(volume, 20)
rangeHL  = high - low
closePos = rangeHL > 0 ? (close - low) / rangeHL : 0.5
bigBody  = body >= nz(atr) * dispBodyAtr or body >= nz(avgBody) * dispBodyMult
bullDisp = close > open and bigBody and closePos >= dispClosePct
bearDisp = close < open and bigBody and (1 - closePos) >= dispClosePct
bullDispFVG = low > high[2]
bearDispFVG = high < low[2]

// =============================================================================
// 11.  CISD (Change In State of Delivery)
// =============================================================================
var bool  inDownRun = false
var float downRunOpen = na
var float lastDownRunOpen = na
var bool  inUpRun = false
var float upRunOpen = na
var float lastUpRunOpen = na
if close < open
    if not inDownRun
        downRunOpen := open
        inDownRun := true
    if inUpRun
        lastUpRunOpen := upRunOpen
    inUpRun := false
else if close > open
    if not inUpRun
        upRunOpen := open
        inUpRun := true
    if inDownRun
        lastDownRunOpen := downRunOpen
    inDownRun := false

// =============================================================================
// 12.  FVG / IFVG STORE
// =============================================================================
type Gap
    box   bx
    float top
    float btm
    bool  isBull
    int   created
    bool  inverted = false

var gaps = array.new<Gap>()

fvgMinSize = math.max(nz(atr) * fvgMinAtr, fvgMinTicks * syminfo.mintick)
newBull = low > high[2] and (low - high[2]) >= fvgMinSize
newBear = high < low[2] and (low[2] - high) >= fvgMinSize

var float lastBullFvgTop = na
var float lastBullFvgBtm = na
var int   lastBullFvgBar = na
var float lastBearFvgTop = na
var float lastBearFvgBtm = na
var int   lastBearFvgBar = na
var float lastBullIfvgTop = na
var float lastBullIfvgBtm = na
var int   lastBullIfvgBar = na
var float lastBearIfvgTop = na
var float lastBearIfvgBtm = na
var int   lastBearIfvgBar = na

col_bullFvg  = color.new(#26a69a, 82)
col_bearFvg  = color.new(#ef5350, 82)
col_bullIfvg = color.new(#00e676, 70)
col_bearIfvg = color.new(#ff5252, 70)

if barstate.isconfirmed
    if newBull
        b = showZones ? box.new(bar_index - 2, low, bar_index, high[2], border_color = col_bullFvg, bgcolor = col_bullFvg) : na
        array.push(gaps, Gap.new(b, low, high[2], true, bar_index))
        lastBullFvgTop := low
        lastBullFvgBtm := high[2]
        lastBullFvgBar := bar_index
    if newBear
        b = showZones ? box.new(bar_index - 2, low[2], bar_index, high, border_color = col_bearFvg, bgcolor = col_bearFvg) : na
        array.push(gaps, Gap.new(b, low[2], high, false, bar_index))
        lastBearFvgTop := low[2]
        lastBearFvgBtm := high
        lastBearFvgBar := bar_index
    if array.size(gaps) > 0
        for i = array.size(gaps) - 1 to 0
            g = array.get(gaps, i)
            if bar_index - g.created > fvgMaxAge
                box.delete(g.bx)
                array.remove(gaps, i)
                continue
            if not na(g.bx)
                box.set_right(g.bx, bar_index)
            if not g.inverted
                brokeDn = ifvgFullClose ? close < g.btm : low < g.btm
                brokeUp = ifvgFullClose ? close > g.top : high > g.top
                if g.isBull and brokeDn
                    g.inverted := true
                    if not na(g.bx)
                        box.set_bgcolor(g.bx, col_bearIfvg)
                        box.set_border_color(g.bx, col_bearIfvg)
                    lastBearIfvgTop := g.top
                    lastBearIfvgBtm := g.btm
                    lastBearIfvgBar := bar_index
                else if not g.isBull and brokeUp
                    g.inverted := true
                    if not na(g.bx)
                        box.set_bgcolor(g.bx, col_bullIfvg)
                        box.set_border_color(g.bx, col_bullIfvg)
                    lastBullIfvgTop := g.top
                    lastBullIfvgBtm := g.btm
                    lastBullIfvgBar := bar_index
    while array.size(gaps) > 60
        g0 = array.shift(gaps)
        box.delete(g0.bx)

// =============================================================================
// 13.  HTF BIAS
// =============================================================================
[c1, e1f, e1s, e1p] = request.security(syminfo.tickerid, biasTF1,
     [close, ta.ema(close, biasEmaFast), ta.ema(close, biasEmaSlow), ta.ema(close, biasEmaFast)[3]],
     lookahead = barmerge.lookahead_off)
[c2, e2f, e2s, e2p] = request.security(syminfo.tickerid, biasTF2,
     [close, ta.ema(close, biasEmaFast), ta.ema(close, biasEmaSlow), ta.ema(close, biasEmaFast)[3]],
     lookahead = barmerge.lookahead_off)
[c3, e3f, e3s, e3p] = request.security(syminfo.tickerid, biasTF3,
     [close, ta.ema(close, biasEmaFast), ta.ema(close, biasEmaSlow), ta.ema(close, biasEmaFast)[3]],
     lookahead = barmerge.lookahead_off)

pdEq  = (nz(lastSwingHigh) + nz(lastSwingLow)) / 2.0
pdDir = (na(lastSwingHigh) or na(lastSwingLow)) ? 0 : close < pdEq ? 1 : close > pdEq ? -1 : 0

f_tfBias(float c, float ef, float es, float ep) =>
    switch biasMethod
        "EMA"              => c > ef and ef > es ? 1 : c < ef and ef < es ? -1 : 0
        "Market Structure" => c > ef and ef >= ep ? 1 : c < ef and ef <= ep ? -1 : 0
        "Premium/Discount" => pdDir
        => manualBias == "Bullish" ? 1 : manualBias == "Bearish" ? -1 : 0

b1 = f_tfBias(c1, e1f, e1s, e1p)
b2 = f_tfBias(c2, e2f, e2s, e2p)
b3 = f_tfBias(c3, e3f, e3s, e3p)

htfDir = switch biasCombine
    "Only TF1 decides"      => b1
    "Majority of the three" => (b1 + b2 + b3) > 0 ? 1 : (b1 + b2 + b3) < 0 ? -1 : 0
    => (b1 != 0 and b1 == b2) ? b1 : 0
biasStr = htfDir == 1 ? "Bullish" : htfDir == -1 ? "Bearish" : "Neutral / Mixed"
htfBothAgree = b1 != 0 and b1 == b2

// =============================================================================
// 14.  ACTIVE SETUP OBJECT + STATE
// =============================================================================
type Setup
    int    dir      = 0
    int    state    = 0
    int    startBar = na
    float  sweepLvl = na
    string sweepName= ""
    int    sweepRank= 0
    float  sweepExt = na
    int    sweepBar = na
    string smtStrong= ""
    int    smtBar   = na
    int    dispBar  = na
    bool   dispFVG  = false
    bool   dispStrong = false
    bool   mssOk    = false
    float  mssLvl   = na
    int    mssBar   = na
    bool   cisdOk   = false
    float  cisdLvl  = na
    int    cisdBar  = na
    bool   fvgOk    = false
    bool   ifvgOk   = false
    float  zoneTop  = na
    float  zoneBtm  = na
    float  entry    = na
    float  stop     = na
    float  tp1      = na
    float  tp2      = na
    float  rr       = na
    bool   tgtReal  = false
    int    score    = 0
    string grade    = ""
    int    entryBar = na
    string reject   = ""
    bool   reentered= false

var Setup S = Setup.new()
var int  cooldownUntil = na
var bool entryFired = false

f_freshSetup() =>
    Setup.new()

// =============================================================================
// 15.  TARGET + SCORE BUILDERS
// =============================================================================
f_pickTarget(int dir, float entry, float risk) =>
    float best = na
    bool  real = false
    if tgtMode == "Fixed RR only" or risk <= 0
        best := dir == 1 ? entry + targetRR * risk : entry - targetRR * risk
        real := false
    else
        cand = array.new<float>()
        if dir == 1
            if usePDHL and not na(pdh)
                array.push(cand, pdh)
            if useAsiaLvl and not na(asiaH)
                array.push(cand, asiaH)
            if useLonLvl and not na(lonH)
                array.push(cand, lonH)
            if useEqual and not na(eqHigh)
                array.push(cand, eqHigh)
            if useSwingLvl and not na(lastSwingHigh)
                array.push(cand, lastSwingHigh)
        else
            if usePDHL and not na(pdl)
                array.push(cand, pdl)
            if useAsiaLvl and not na(asiaL)
                array.push(cand, asiaL)
            if useLonLvl and not na(lonL)
                array.push(cand, lonL)
            if useEqual and not na(eqLow)
                array.push(cand, eqLow)
            if useSwingLvl and not na(lastSwingLow)
                array.push(cand, lastSwingLow)
        float bestDist = na
        if array.size(cand) > 0
            for i = 0 to array.size(cand) - 1
                lv = array.get(cand, i)
                beyond = dir == 1 ? lv > entry : lv < entry
                rr = risk > 0 ? (dir == 1 ? lv - entry : entry - lv) / risk : 0.0
                if beyond and rr >= minRR
                    d = math.abs(lv - entry)
                    if na(bestDist) or d < bestDist
                        bestDist := d
                        best := lv
                        real := true
        if na(best)
            best := dir == 1 ? entry + targetRR * risk : entry - targetRR * risk
            real := false
    [best, real]

f_score(Setup s) =>
    int pts = 0
    // HTF bias (max 15)
    pts += (b1 == s.dir ? 5 : 0) + (b2 == s.dir ? 7 : 0) + (b3 == s.dir ? 3 : 0)
    // Liquidity location (max 15) — ranks are already <= 15
    pts += s.sweepRank
    // Sweep quality (max 10)
    pts += sweepQualPts
    // SMT quality (max 15) derived from level rank
    pts += s.sweepRank >= 13 ? 15 : s.sweepRank >= 10 ? 12 : s.sweepRank >= 8 ? 10 : 8
    // Displacement (max 10)
    pts += (s.dispStrong and s.dispFVG) ? 10 : s.dispFVG ? 8 : not na(s.dispBar) ? 4 : 0
    // Structure (max 10)
    pts += (s.mssOk and s.cisdOk) ? 10 : s.mssOk ? 8 : s.cisdOk ? 7 : 0
    // Entry zone (max 10)
    pts += s.ifvgOk ? 10 : s.fvgOk ? 8 : 2
    // Session timing (max 5)
    pts += sessScore
    // Risk/Reward (max 5)
    pts += s.rr >= 3 ? 5 : s.rr >= 2 ? 3 : 0
    // Additional confluence (max 5)
    int conf = 0
    conf += pdDir == s.dir ? 2 : 0
    conf += volume > nz(volSma20) * 1.5 ? 2 : 0
    conf += s.tgtReal ? 1 : 0
    pts += conf
    pts > 100 ? 100 : pts

// =============================================================================
// 16.  STATE MACHINE  (mutates only on confirmed bars -> no repaint)
// =============================================================================
bool alBullSMT = false
bool alBearSMT = false
bool alAplusLong = false
bool alAplusShort = false
bool alALong = false
bool alAShort = false
bool alRetest = false
bool alInvalid = false
bool alTP1 = false
bool alTP2 = false
bool alStop = false
bool becameWaitNow = false
bool entryTriggeredNow = false
int  entryTrigDir = 0

// recent SMT / sweep memory (updated only on confirmed bars)
var int    lastBullSmtBar = na
var string lastBullStrong = ""
var int    lastBearSmtBar = na
var string lastBearStrong = ""
var int    lastBullSweepBar = na
var float  lastBullSweepLvl = na
var string lastBullSweepName = ""
var int    lastBullSweepRank = 0
var float  lastBullSweepExt = na
var int    lastBearSweepBar = na
var float  lastBearSweepLvl = na
var string lastBearSweepName = ""
var int    lastBearSweepRank = 0
var float  lastBearSweepExt = na

if barstate.isconfirmed
    // ---- record events ----
    if bullSMT
        lastBullSmtBar := nz(smtPvtBar, bar_index)
        lastBullStrong := smtStrong
        alBullSMT := true
    if bearSMT
        lastBearSmtBar := nz(smtPvtBar, bar_index)
        lastBearStrong := smtStrong
        alBearSMT := true
    if bullSweep
        lastBullSweepBar := bar_index
        lastBullSweepLvl := bswV
        lastBullSweepName := bswN
        lastBullSweepRank := bswR
        lastBullSweepExt := bswExt
    if bearSweep
        lastBearSweepBar := bar_index
        lastBearSweepLvl := hswV
        lastBearSweepName := hswN
        lastBearSweepRank := hswR
        lastBearSweepExt := hswExt

    inCooldown = not na(cooldownUntil) and bar_index < cooldownUntil

    // ---- global expiry / strong-bias invalidation for a forming setup ----
    if S.state != ST_IDLE and S.state != ST_ENTRY
        if not na(S.startBar) and (bar_index - S.startBar) > setupMaxAge
            S.state := ST_EXPIRED
            S.reject := "Setup expired (too old)"
            alInvalid := true
        else if htfBothAgree and htfDir == -S.dir
            S.state := ST_INVALID
            S.reject := "Opposed by strong HTF bias"
            alInvalid := true

    // ---- IDLE: seed when a fresh SMT pairs with a recent sweep ----
    if S.state == ST_IDLE and not inCooldown
        bullPair = not na(lastBullSmtBar) and (bar_index - lastBullSmtBar) <= smtMaxAge and not na(lastBullSweepBar) and math.abs(lastBullSweepBar - lastBullSmtBar) <= (maxSweepToSmt + pvtRight)
        bearPair = not na(lastBearSmtBar) and (bar_index - lastBearSmtBar) <= smtMaxAge and not na(lastBearSweepBar) and math.abs(lastBearSweepBar - lastBearSmtBar) <= (maxSweepToSmt + pvtRight)
        if bullPair
            S := f_freshSetup()
            S.dir := 1
            S.state := ST_SMT
            S.startBar := bar_index
            S.sweepLvl := lastBullSweepLvl
            S.sweepName := lastBullSweepName
            S.sweepRank := lastBullSweepRank
            S.sweepExt := lastBullSweepExt
            S.sweepBar := lastBullSweepBar
            S.smtStrong := lastBullStrong
            S.smtBar := lastBullSmtBar
            entryFired := false
            lastBullSmtBar := na
        else if bearPair
            S := f_freshSetup()
            S.dir := -1
            S.state := ST_SMT
            S.startBar := bar_index
            S.sweepLvl := lastBearSweepLvl
            S.sweepName := lastBearSweepName
            S.sweepRank := lastBearSweepRank
            S.sweepExt := lastBearSweepExt
            S.sweepBar := lastBearSweepBar
            S.smtStrong := lastBearStrong
            S.smtBar := lastBearSmtBar
            entryFired := false
            lastBearSmtBar := na

    // ---- SMT_CONFIRMED -> displacement ----
    if S.state == ST_SMT
        if (bar_index - S.smtBar) > maxSmtToDisp
            S.state := ST_INVALID
            S.reject := "No displacement in time"
            alInvalid := true
        else if (S.dir == 1 and bullDisp) or (S.dir == -1 and bearDisp)
            S.state := ST_DISP
            S.dispBar := bar_index
            S.dispFVG := S.dir == 1 ? bullDispFVG : bearDispFVG
            S.dispStrong := body >= nz(atr) * dispBodyAtr * 1.5

    // ---- DISPLACEMENT -> MSS / CISD ----
    if S.state == ST_DISP
        if (bar_index - S.dispBar) > maxDispToMss
            S.state := ST_INVALID
            S.reject := "No MSS/CISD in time"
            alInvalid := true
        else
            if S.dir == 1
                mss = not na(lastIntHigh) and (mssReqClose ? close > lastIntHigh : high > lastIntHigh)
                if mss and not S.mssOk
                    S.mssOk := true
                    S.mssLvl := lastIntHigh
                    S.mssBar := bar_index
                cisd = not na(lastDownRunOpen) and close > lastDownRunOpen
                if cisd and not S.cisdOk
                    S.cisdOk := true
                    S.cisdLvl := lastDownRunOpen
                    S.cisdBar := bar_index
            else
                mss = not na(lastIntLow) and (mssReqClose ? close < lastIntLow : low < lastIntLow)
                if mss and not S.mssOk
                    S.mssOk := true
                    S.mssLvl := lastIntLow
                    S.mssBar := bar_index
                cisd = not na(lastUpRunOpen) and close < lastUpRunOpen
                if cisd and not S.cisdOk
                    S.cisdOk := true
                    S.cisdLvl := lastUpRunOpen
                    S.cisdBar := bar_index
            structDone = switch structNeed
                "MSS only"          => S.mssOk
                "CISD only"         => S.cisdOk
                "Both MSS and CISD" => S.mssOk and S.cisdOk
                => S.mssOk or S.cisdOk
            if structDone
                S.state := ST_SHIFT

    // ---- STRUCTURE SHIFT -> entry zone + price + score + grade ----
    if S.state == ST_SHIFT
        if S.dir == 1
            if not na(lastBullIfvgBar) and lastBullIfvgBar >= S.smtBar
                S.ifvgOk := true
                S.zoneTop := lastBullIfvgTop
                S.zoneBtm := lastBullIfvgBtm
            else if not na(lastBullFvgBar) and (not fvgFromDisp or lastBullFvgBar >= S.dispBar)
                S.fvgOk := true
                S.zoneTop := lastBullFvgTop
                S.zoneBtm := lastBullFvgBtm
        else
            if not na(lastBearIfvgBar) and lastBearIfvgBar >= S.smtBar
                S.ifvgOk := true
                S.zoneTop := lastBearIfvgTop
                S.zoneBtm := lastBearIfvgBtm
            else if not na(lastBearFvgBar) and (not fvgFromDisp or lastBearFvgBar >= S.dispBar)
                S.fvgOk := true
                S.zoneTop := lastBearFvgTop
                S.zoneBtm := lastBearFvgBtm

        if S.fvgOk or S.ifvgOk
            S.entry := switch entryZoneMode
                "Proximal" => S.dir == 1 ? S.zoneTop : S.zoneBtm
                "Distal"   => S.dir == 1 ? S.zoneBtm : S.zoneTop
                => (S.zoneTop + S.zoneBtm) / 2.0
            buf = nz(atr) * stopBufAtr
            rawStop = switch stopMethod
                "Beyond swing"       => S.dir == 1 ? nz(lastSwingLow, S.sweepExt) : nz(lastSwingHigh, S.sweepExt)
                "Beyond zone"        => S.dir == 1 ? S.zoneBtm : S.zoneTop
                "Beyond swept level" => nz(S.sweepLvl, S.sweepExt)
                => S.sweepExt
            S.stop := S.dir == 1 ? rawStop - buf : rawStop + buf
            risk = math.abs(S.entry - S.stop)
            [tgt, real] = f_pickTarget(S.dir, S.entry, risk)
            S.tgtReal := real
            S.tp2 := tgt
            S.tp1 := S.dir == 1 ? S.entry + minRR * risk : S.entry - minRR * risk
            S.rr := risk > 0 ? math.abs(tgt - S.entry) / risk : 0.0
            if S.rr > maxRRcap
                S.tp2 := S.dir == 1 ? S.entry + maxRRcap * risk : S.entry - maxRRcap * risk
                S.rr := maxRRcap
            S.score := f_score(S)
            mandA = (S.fvgOk or S.ifvgOk) and (S.mssOk or S.cisdOk) and not na(S.dispBar) and S.rr >= minRR and inActiveSession and not (htfBothAgree and htfDir == -S.dir)
            S.grade := (S.score >= minAplus and mandA and (htfDir == S.dir or htfDir == 0)) ? "A+" : (S.score >= minAscore and mandA) ? "A" : S.score >= minBscore ? "B" : "C"
            S.state := ST_WAIT
            becameWaitNow := true
        else if (bar_index - S.dispBar) > maxDispToMss + 3
            S.state := ST_INVALID
            S.reject := "No FVG/IFVG entry zone"
            alInvalid := true

    // ---- WAITING FOR RETEST ----
    if S.state == ST_WAIT
        hitTargetFirst = S.dir == 1 ? high >= S.tp2 : low <= S.tp2
        zoneGone = S.dir == 1 ? close < S.stop : close > S.stop
        if (bar_index - S.startBar) > setupMaxAge
            S.state := ST_EXPIRED
            S.reject := "Expired before retest"
            alInvalid := true
        else if hitTargetFirst
            S.state := ST_INVALID
            S.reject := "Target hit before entry"
            alInvalid := true
        else if zoneGone
            S.state := ST_INVALID
            S.reject := "Zone invalidated before retest"
            alInvalid := true
        else
            touched = low <= S.zoneTop and high >= S.zoneBtm
            if touched
                alRetest := true
                reached = S.dir == 1 ? low <= S.entry : high >= S.entry
                if reached and not entryFired
                    S.state := ST_ENTRY
                    S.entryBar := bar_index
                    entryFired := true
                    entryTriggeredNow := true
                    entryTrigDir := S.dir
                    if S.grade == "A+" and S.dir == 1
                        alAplusLong := true
                    if S.grade == "A+" and S.dir == -1
                        alAplusShort := true
                    if S.grade == "A" and S.dir == 1
                        alALong := true
                    if S.grade == "A" and S.dir == -1
                        alAShort := true
                    // rich dynamic alert (fires live via alert() )
                    msg = S.grade + " " + (S.dir == 1 ? "LONG" : "SHORT") + " | " + syminfo.root + "/" + compName + " SMT | Score " + str.tostring(S.score) + " | " + S.sweepName + " Sweep | Entry " + f_px(S.entry) + " | SL " + f_px(S.stop) + " | TP " + f_px(S.tp2) + " | RR " + str.tostring(S.rr, "#.#")
                    alert(msg, alert.freq_once_per_bar)

    // ---- ENTRY TRIGGERED -> manage result, cooldown ----
    if S.state == ST_ENTRY
        hitStop = S.dir == 1 ? low <= S.stop : high >= S.stop
        hitTP1  = S.dir == 1 ? high >= S.tp1 : low <= S.tp1
        hitTP2  = S.dir == 1 ? high >= S.tp2 : low <= S.tp2
        if hitTP1
            alTP1 := true
        if hitTP2
            alTP2 := true
        if hitStop
            alStop := true
        if hitTP2 or hitStop
            cooldownUntil := bar_index + cooldownBars
            if allowReentry and not S.reentered and hitStop
                S.reentered := true
                S.state := ST_WAIT
                entryFired := false
            else
                S := f_freshSetup()

    // ---- terminal states -> cooldown + reset ----
    if S.state == ST_INVALID or S.state == ST_EXPIRED
        cooldownUntil := bar_index + cooldownBars
        S := f_freshSetup()

// display gate for the grade
showThisGrade = S.grade == "A+" or (tradeMode == "Flexible" and S.score >= flexMinScore and ((S.grade == "A") or (S.grade == "B" and showB) or (S.grade == "C" and showC)))

// =============================================================================
// 17.  DRAWING (setups drawn once, on transition to WAITING_FOR_RETEST)
// =============================================================================
var trLines  = array.new<line>()
var trLabels = array.new<label>()

f_trimDrawings() =>
    while array.size(trLabels) > maxSetupsDrawn * 2
        label.delete(array.shift(trLabels))
    while array.size(trLines) > maxSetupsDrawn * 6
        line.delete(array.shift(trLines))

col_long  = color.new(#00c853, 0)
col_short = color.new(#d50000, 0)
col_stop  = color.new(#ff1744, 0)
col_tp    = color.new(#2962ff, 0)

if barstate.isconfirmed and becameWaitNow and showThisGrade
    dirCol = S.dir == 1 ? col_long : col_short
    x1 = nz(S.sweepBar, bar_index - 5)
    x2 = bar_index + maxWaitRetest
    if showTrade
        le = line.new(x1, S.entry, x2, S.entry, color = dirCol, width = 2)
        ls = line.new(x1, S.stop,  x2, S.stop,  color = col_stop, style = line.style_dashed)
        array.push(trLines, le)
        array.push(trLines, ls)
        if showTP2
            l2 = line.new(x1, S.tp2, x2, S.tp2, color = col_tp, width = 2)
            array.push(trLines, l2)
        if showTP1
            l1 = line.new(x1, S.tp1, x2, S.tp1, color = color.new(col_tp, 45), style = line.style_dotted)
            array.push(trLines, l1)
    if showStruct and S.mssOk and not na(S.mssLvl)
        lm = line.new(nz(S.dispBar, x1), S.mssLvl, bar_index, S.mssLvl, color = color.new(color.orange, 20), style = line.style_dashed)
        array.push(trLines, lm)
    if showSmtLine and not na(S.smtBar)
        lsmt = line.new(S.smtBar, S.dir == 1 ? S.sweepExt : nz(S.sweepLvl, high), bar_index, S.dir == 1 ? low : high, color = color.new(color.purple, 10), style = line.style_dotted)
        array.push(trLines, lsmt)
    if showScoreLbl
        dirTxt = S.dir == 1 ? "LONG" : "SHORT"
        structTxt = (S.mssOk ? "MSS" : "") + (S.mssOk and S.cisdOk ? "+" : "") + (S.cisdOk ? "CISD" : "")
        zoneTxt = S.ifvgOk ? "IFVG" : "FVG"
        head = S.grade + " " + dirTxt + " | Score: " + str.tostring(S.score)
        sub = S.sweepName + " Sweep + " + (S.dir == 1 ? "Bull" : "Bear") + " SMT + " + structTxt + " + " + zoneTxt + " + " + str.tostring(S.rr, "#.#") + "R"
        lab = label.new(bar_index, S.stop, head + "\n" + sub, yloc = yloc.price, style = S.dir == 1 ? label.style_label_up : label.style_label_down, color = S.grade == "A+" ? dirCol : color.new(dirCol, 35), textcolor = color.white, size = size.small)
        array.push(trLabels, lab)
    f_trimDrawings()

// entry + sweep markers
plotshape(barstate.isconfirmed and entryTriggeredNow and entryTrigDir == 1 and showTrade, "Long entry",  style = shape.triangleup,   location = location.belowbar, color = col_long,  size = size.small)
plotshape(barstate.isconfirmed and entryTriggeredNow and entryTrigDir == -1 and showTrade, "Short entry", style = shape.triangledown, location = location.abovebar, color = col_short, size = size.small)
plotshape(barstate.isconfirmed and bullSweep and showSweep, "Bull sweep", style = shape.xcross, location = location.belowbar, color = color.new(color.teal, 0),   size = size.tiny)
plotshape(barstate.isconfirmed and bearSweep and showSweep, "Bear sweep", style = shape.xcross, location = location.abovebar, color = color.new(color.maroon, 0), size = size.tiny)

// =============================================================================
// 18.  PERSISTENT LEVEL LINES (updated, not recreated)
// =============================================================================
f_lvlLine(line ln, float v, color c) =>
    line result = ln
    if showLevels and not na(v)
        if na(ln)
            result := line.new(bar_index - 50, v, bar_index + 5, v, color = c, width = 1, style = line.style_dotted)
        else
            line.set_xy1(result, bar_index - 50, v)
            line.set_xy2(result, bar_index + 5, v)
    result

var line lnPDH = na
var line lnPDL = na
var line lnAsiaH = na
var line lnAsiaL = na
var line lnLonH = na
var line lnLonL = na
if barstate.islast
    lnPDH := f_lvlLine(lnPDH, usePDHL ? pdh : na, color.new(color.gray, 20))
    lnPDL := f_lvlLine(lnPDL, usePDHL ? pdl : na, color.new(color.gray, 20))
    lnAsiaH := f_lvlLine(lnAsiaH, useAsiaLvl ? asiaH : na, color.new(#f2a900, 30))
    lnAsiaL := f_lvlLine(lnAsiaL, useAsiaLvl ? asiaL : na, color.new(#f2a900, 30))
    lnLonH := f_lvlLine(lnLonH, useLonLvl ? lonH : na, color.new(#3b6cff, 30))
    lnLonL := f_lvlLine(lnLonL, useLonLvl ? lonL : na, color.new(#3b6cff, 30))

// SMT label at the confirmed pivot (non-repainting)
if barstate.isconfirmed and showSmtLine and (bullSMT or bearSMT)
    txt = (bullSMT ? "Bull SMT" : "Bear SMT") + "\n" + syminfo.root + " / " + compName
    label.new(bar_index, bullSMT ? low : high, txt, yloc = bullSMT ? yloc.belowbar : yloc.abovebar, style = bullSMT ? label.style_label_up : label.style_label_down, color = color.new(color.purple, 20), textcolor = color.white, size = size.tiny)

// session background
bgCol = sessId == 1 ? color.new(#787b86, 94) : sessId == 2 ? color.new(#3b6cff, 92) : sessId == 3 ? color.new(#26a69a, 90) : sessId == 4 ? color.new(#ef5350, 92) : na
bgcolor(showBg ? bgCol : na, title = "Session background")

// =============================================================================
// 19.  DASHBOARD
// =============================================================================
var table dash = na

f_cell(int r, string k, string v, color vc) =>
    table.cell(dash, 0, r, k, text_color = color.new(color.gray, 0), text_size = size.tiny, text_halign = text.align_left)
    table.cell(dash, 1, r, v, text_color = vc, text_size = size.tiny, text_halign = text.align_right)

if showDash and barstate.islast
    rows = debugMode ? 24 : 19
    if na(dash)
        dash := table.new(f_pos(dashPos), 2, rows, bgcolor = color.new(color.black, 82), border_color = color.new(color.gray, 55), border_width = 1, frame_color = color.new(color.gray, 40), frame_width = 1)
    gradeCol = S.grade == "A+" ? color.new(#00e676, 0) : S.grade == "A" ? color.lime : S.grade == "B" ? color.yellow : S.grade == "C" ? color.gray : color.white
    dirColT = S.dir == 1 ? color.lime : S.dir == -1 ? color.red : color.white
    table.cell(dash, 0, 0, "SMT A+ · " + syminfo.root + "/" + compName, text_color = color.white, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 0, timeframe.period, text_color = color.new(color.gray, 0), text_size = size.small, text_halign = text.align_right)
    f_cell(1,  "HTF Bias", biasStr, htfDir == 1 ? color.lime : htfDir == -1 ? color.red : color.white)
    f_cell(2,  "Bias TF1/2/3", (b1 == 1 ? "▲" : b1 == -1 ? "▼" : "•") + " " + (b2 == 1 ? "▲" : b2 == -1 ? "▼" : "•") + " " + (b3 == 1 ? "▲" : b3 == -1 ? "▼" : "•"), color.white)
    f_cell(3,  "Active session", f_sessName(sessId), (sessId == 3 or sessId == 4) ? color.lime : color.white)
    f_cell(4,  "Last SMT", (not na(lastBullSmtBar) and (na(lastBearSmtBar) or lastBullSmtBar > lastBearSmtBar)) ? "Bullish" : not na(lastBearSmtBar) ? "Bearish" : "-", color.white)
    f_cell(5,  "Liquidity swept", S.sweepName == "" ? "-" : S.sweepName, color.white)
    f_cell(6,  "Displacement", not na(S.dispBar) ? "OK" : "-", not na(S.dispBar) ? color.lime : color.gray)
    f_cell(7,  "MSS", S.mssOk ? "OK" : "-", S.mssOk ? color.lime : color.gray)
    f_cell(8,  "CISD", S.cisdOk ? "OK" : "-", S.cisdOk ? color.lime : color.gray)
    f_cell(9,  "FVG", S.fvgOk ? "OK" : "-", S.fvgOk ? color.lime : color.gray)
    f_cell(10, "IFVG", S.ifvgOk ? "OK" : "-", S.ifvgOk ? color.lime : color.gray)
    f_cell(11, "Score", S.state == ST_IDLE ? "-" : str.tostring(S.score), gradeCol)
    f_cell(12, "Grade", S.grade == "" ? "-" : S.grade, gradeCol)
    f_cell(13, "Direction", S.dir == 1 ? "LONG" : S.dir == -1 ? "SHORT" : "-", dirColT)
    f_cell(14, "Entry", f_px(S.entry), color.white)
    f_cell(15, "Stop", f_px(S.stop), color.new(#ff1744, 0))
    f_cell(16, "Target", f_px(S.tp2), color.new(#2962ff, 0))
    f_cell(17, "RR", na(S.rr) ? "-" : str.tostring(S.rr, "#.##"), S.rr >= targetRR ? color.lime : S.rr >= minRR ? color.yellow : color.white)
    f_cell(18, "State", f_stateName(S.state), color.new(color.aqua, 0))
    if debugMode
        f_cell(19, "Reject reason", S.reject == "" ? "-" : S.reject, color.orange)
        f_cell(20, "Bars since SMT", na(S.smtBar) ? "-" : str.tostring(bar_index - S.smtBar), color.white)
        f_cell(21, "ATR / cATR", str.tostring(atr, "#.##") + " / " + str.tostring(cATR, "#.##"), color.white)
        f_cell(22, "MSS level", f_px(S.mssLvl), color.white)
        f_cell(23, "Strong sym (held)", S.smtStrong == "" ? "-" : S.smtStrong, color.white)

// =============================================================================
// 20.  ALERTS
// =============================================================================
alertcondition(alBullSMT,     "Bullish SMT detected", "Bullish SMT detected {{ticker}} {{interval}}")
alertcondition(alBearSMT,     "Bearish SMT detected", "Bearish SMT detected {{ticker}} {{interval}}")
alertcondition(alAplusLong,   "A+ Long setup ready",  "A+ LONG entry retest reached {{ticker}} {{interval}}")
alertcondition(alAplusShort,  "A+ Short setup ready", "A+ SHORT entry retest reached {{ticker}} {{interval}}")
alertcondition(alALong,       "A Long setup ready",   "A LONG entry retest reached {{ticker}} {{interval}}")
alertcondition(alAShort,      "A Short setup ready",  "A SHORT entry retest reached {{ticker}} {{interval}}")
alertcondition(alRetest,      "Entry retest reached", "Price retested the entry zone {{ticker}} {{interval}}")
alertcondition(alInvalid,     "Setup invalidated",    "Setup invalidated {{ticker}} {{interval}}")
alertcondition(alTP1,         "TP1 reached",          "TP1 reached {{ticker}} {{interval}}")
alertcondition(alTP2,         "TP2 reached",          "TP2 reached {{ticker}} {{interval}}")
alertcondition(alStop,        "Stop reached",         "Stop reached {{ticker}} {{interval}}")
alertcondition(entryTriggeredNow, "Setup entry triggered (main)", "SMT A+ setup entry retest reached — see chart label {{ticker}} {{interval}}")
