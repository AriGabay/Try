//@version=6
indicator("Breakout Retest — Entries & Exits", "BO-RETEST", overlay = true,
     max_boxes_count = 500, max_labels_count = 500, max_lines_count = 500)

// ═════════════════════════════════════════════════════════════════════════════
//  WHAT THIS DOES
//
//  A shelf is a horizontal price level with no fixed polarity. Every time a
//  candle CLOSES through a shelf with real force, the shelf flips role —
//  resistance becomes support, support becomes resistance. This indicator
//  trades that flip, but only after price proves it:
//
//      shelf  →  breakout close  →  thrust away from the shelf
//             →  pullback into the flipped shelf  →  rejection candle
//             →  ENTRY  →  managed bar by bar  →  EXIT
//
//  Each entry is drawn with its stop and two targets. Each trade is closed on
//  the chart with the R multiple it actually produced.
//
//  Nothing repaints: every transition is evaluated under barstate.isconfirmed,
//  pivots are only accepted after their right-hand bars complete, and the
//  higher-timeframe request uses lookahead_off on a closed bar.
// ═════════════════════════════════════════════════════════════════════════════


// ═══ CONFIGURATION ═══════════════════════════════════════════════════════════

var string G_SHELF = "1 · Shelves"
pivotL   = input.int(8, "Pivot bars — left", minval = 1, inline = "pv", group = G_SHELF)
pivotR   = input.int(8, "right",             minval = 1, inline = "pv", group = G_SHELF,
     tooltip = "A pivot is only accepted once this many bars have closed after it. The delay is the price of never repainting.")
useHTF   = input.bool(true, "Add previous day's high and low", group = G_SHELF)
fuseAtr  = input.float(0.35, "Fuse shelves closer than (× ATR)", minval = 0.0, step = 0.05, group = G_SHELF,
     tooltip = "Two prices this close describe the same shelf. The newer one is absorbed as an extra test instead of drawing a second line.")
shelfCap = input.int(14,  "Shelves tracked",       minval = 2, maxval = 40, group = G_SHELF)
shelfAge = input.int(600, "Shelf lifespan (bars)", minval = 20, group = G_SHELF)
minTests = input.int(1, "Tests required before a break counts", minval = 1, maxval = 6, group = G_SHELF,
     tooltip = "1 accepts any confirmed shelf. Raise to 2–3 to trade only prices the market has already defended more than once.")

var string G_BREAK = "2 · Breakout"
atrLen   = input.int(14, "ATR length", minval = 1, group = G_BREAK)
clearAtr = input.float(0.10, "Close must clear the shelf by (× ATR)", minval = 0.0, step = 0.05, group = G_BREAK,
     tooltip = "A wick through a shelf is not a breakout. The candle has to close this far past it.")
forceStr = input.string("Body or volume", "Force filter",
     options = ["Body or volume", "Body and volume", "Body only", "Volume only", "None"], group = G_BREAK)
bodyAtr  = input.float(1.5, "Body at least (× ATR)", minval = 0.0, step = 0.1, group = G_BREAK)
volLen   = input.int(20,  "Volume average length", minval = 1, inline = "vl", group = G_BREAK)
volMult  = input.float(1.5, "× average",           minval = 0.0, step = 0.1, inline = "vl", group = G_BREAK)
settleN  = input.int(3, "Bars price must settle on one side first", minval = 1, group = G_BREAK,
     tooltip = "Without this, price chopping across a shelf fires a breakout every other bar.")
coolN    = input.int(20, "Cooldown per shelf (bars)", minval = 0, group = G_BREAK)

var string G_RETEST = "3 · Retest"
thrustAtr = input.float(1.0, "Thrust required before a retest (× ATR)", minval = 0.0, step = 0.1, group = G_RETEST,
     tooltip = "Price has to genuinely leave the shelf first. Skip this and every breakout-and-turn masquerades as a retest.")
zoneAtr   = input.float(0.30, "Retest zone half-width (× ATR)", minval = 0.05, step = 0.05, group = G_RETEST,
     tooltip = "The retest is an area, not a tick. An order resting on the exact shelf price misses constantly.")
voidAtr   = input.float(0.55, "Void the setup on a close back through (× ATR)", minval = 0.1, step = 0.05, group = G_RETEST)
waitMin   = input.int(2,  "Earliest retest (bars after break)", minval = 0, group = G_RETEST)
waitMax   = input.int(30, "Latest retest (bars after break)",   minval = 2, group = G_RETEST)
takePrev  = input.bool(true, "Rejection candle must take the previous bar's extreme", group = G_RETEST,
     tooltip = "Long: close above the prior bar's high. Cuts out the 'touched it and hoped' entries.")
quietPull = input.bool(false, "Require the rejection bar's volume to fade", group = G_RETEST,
     tooltip = "A pullback nobody is selling into. Stricter, and it will cost you valid trades.")

var string G_RISK = "4 · Stop and targets"
padAtr  = input.float(0.30, "Stop padding past the pullback extreme (× ATR)", minval = 0.0, step = 0.05, group = G_RISK,
     tooltip = "A stop resting exactly on the shelf is liquidity waiting to be taken.")
capAtr  = input.float(3.0, "Reject setups whose stop exceeds (× ATR, 0 = off)", minval = 0.0, step = 0.5, group = G_RISK)
r1      = input.float(1.0, "First target (R)", minval = 0.1, step = 0.1, group = G_RISK)
t2Mode  = input.string("R multiple", "Second target", options = ["R multiple", "Projected leg"], group = G_RISK,
     tooltip = "Projected leg = the distance from the shelf to the thrust extreme, replayed from the entry price.")
r2      = input.float(3.0, "Second target (R)", minval = 0.2, step = 0.1, group = G_RISK)
legMult = input.float(1.0, "Leg projection multiplier", minval = 0.1, step = 0.1, group = G_RISK)
minRR   = input.float(2.0, "Skip anything below this R:R", minval = 0.0, step = 0.1, group = G_RISK)

var string G_MANAGE = "5 · Management"
solo      = input.bool(true, "One position at a time", group = G_MANAGE)
scalePc   = input.float(50, "Scale out at the first target (%)", minval = 0, maxval = 100, step = 5, group = G_MANAGE)
liftToBE  = input.bool(true, "Lift the stop to break-even after the first target", group = G_MANAGE)
bePad     = input.float(0.05, "Break-even padding (× ATR)", minval = 0.0, step = 0.05, group = G_MANAGE)
trailPvt  = input.bool(false, "Trail the runner behind swing pivots", group = G_MANAGE)
holdMax   = input.int(150, "Abandon after (bars, 0 = off)", minval = 0, group = G_MANAGE)

var string G_SIZE = "6 · Sizing"
equity  = input.float(25000, "Account size", minval = 0, step = 1000, group = G_SIZE)
riskPct = input.float(0.75, "Risk per trade (%)", minval = 0.0, maxval = 10, step = 0.05, group = G_SIZE,
     tooltip = "Stop distance dictates the size. Never the other way around.")

var string G_DRAW = "7 · Drawing"
drawShelves = input.bool(true, "Shelf lines",  inline = "w1", group = G_DRAW)
drawZones   = input.bool(true, "Retest zones", inline = "w1", group = G_DRAW)
drawLevels  = input.bool(true, "Stop and target lines", inline = "w2", group = G_DRAW)
drawTags    = input.bool(true, "Entry and exit labels", inline = "w2", group = G_DRAW)
drawPanel   = input.bool(true, "Summary panel", inline = "w3", group = G_DRAW)
panelWhere  = input.string("Top right", "", options = ["Top right", "Top left", "Bottom right", "Bottom left"], inline = "w3", group = G_DRAW)
cUp    = input.color(color.new(#26c281, 0),  "Long",   inline = "w4", group = G_DRAW)
cDn    = input.color(color.new(#e74c3c, 0),  "Short",  inline = "w4", group = G_DRAW)
cShelf = input.color(color.new(#9aa4b2, 35), "Shelf",  inline = "w4", group = G_DRAW)
cStop  = input.color(color.new(#ff5252, 20), "Stop",   inline = "w5", group = G_DRAW)
cTgt   = input.color(color.new(#00e676, 20), "Target", inline = "w5", group = G_DRAW)


// ═══ MARKET CONTEXT ══════════════════════════════════════════════════════════
// Every ta.* call sits here at the top level. Called from inside a conditional
// block their internal state would only advance on the bars that entered the
// block, and the values would silently drift.

atr   = ta.atr(atrLen)
ready = not na(atr) and atr > 0

candleBody = math.abs(close - open)
volAvg     = ta.sma(nz(volume), volLen)
volRatio   = na(volAvg) or volAvg <= 0 ? 1.0 : nz(volume) / volAvg

pivotHi = ta.pivothigh(pivotL, pivotR)
pivotLo = ta.pivotlow(pivotL, pivotR)
swingHi = ta.valuewhen(not na(pivotHi), pivotHi, 0)
swingLo = ta.valuewhen(not na(pivotLo), pivotLo, 0)

[prevHigh, prevLow] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead = barmerge.lookahead_off)
dayTurned = ta.change(time("D")) != 0

hasForce() =>
    bigBody = candleBody >= bodyAtr * atr
    bigVol  = volRatio  >= volMult
    result  = true
    if forceStr == "Body or volume"
        result := bigBody or bigVol
    else if forceStr == "Body and volume"
        result := bigBody and bigVol
    else if forceStr == "Body only"
        result := bigBody
    else if forceStr == "Volume only"
        result := bigVol
    result


// ═══ MODEL ═══════════════════════════════════════════════════════════════════

// A price the market has defended. `facing` records which side price is
// currently on; a flip of that value is what a breakout actually is.
type Shelf
    float px
    int   born
    int   tests
    int   facing     // +1 price above the shelf, -1 below
    int   settled    // consecutive confirmed bars spent on that side
    int   lastBreak
    line  ln

// A breakout on probation. It becomes tradeable only once it has thrust away
// and then come back.
type Watch
    int   way        // +1 long, -1 short
    float px         // the shelf that broke
    int   born       // bar of the breakout close
    float reach      // furthest excursion since the break
    bool  thrust     // reach cleared the thrust requirement
    bool  tagged     // price has entered the retest zone
    float pull       // pullback extreme since tagging
    box   bx

// A live position, carried until it is closed on the chart.
type Position
    int   way
    float fill
    float risk
    float stop
    float t1
    float t2
    int   opened
    bool  scaled
    line  lnFill
    line  lnStop
    line  lnT1
    line  lnT2


// ═══ BEHAVIOUR ═══════════════════════════════════════════════════════════════

method stretch(Shelf s) =>
    if not na(s.ln)
        line.set_x2(s.ln, bar_index)
        line.set_color(s.ln, color.new(cShelf, math.max(0, 55 - s.tests * 8)))
        line.set_width(s.ln, s.tests >= 3 ? 2 : 1)

method pierced(Shelf s) =>
    high >= s.px and low <= s.px

method mature(Shelf s) =>
    s.settled >= settleN and s.tests >= minTests and bar_index - s.lastBreak >= coolN

method zoneHi(Watch w) =>
    w.px + zoneAtr * atr

method zoneLo(Watch w) =>
    w.px - zoneAtr * atr

// The breakout has been absorbed, or it simply never came back in time.
method expired(Watch w) =>
    (close - w.px) * w.way <= -voidAtr * atr or bar_index - w.born > waitMax

method advance(Watch w) =>
    w.reach := w.way == 1 ? math.max(w.reach, high) : math.min(w.reach, low)
    if not w.thrust and (w.reach - w.px) * w.way >= thrustAtr * atr
        w.thrust := true
    if drawZones and not na(w.bx)
        box.set_right(w.bx, bar_index)

// A rejection candle closing back in the breakout's favour, taken from inside
// the zone. This is the trigger, not the touch itself.
method rejects(Watch w) =>
    d       = w.way
    reclaim = d == 1 ? close > open and close > w.px : close < open and close < w.px
    extreme = not takePrev or (d == 1 ? close > high[1] : close < low[1])
    fading  = not quietPull or nz(volume) < nz(volume[1])
    reclaim and extreme and fading

method proposedStop(Watch w) =>
    w.pull - w.way * padAtr * atr

method reprice(Position p, float newStop, bool restart) =>
    p.stop := newStop
    if drawLevels and not na(p.lnStop)
        if restart
            // End the old stop segment and begin a new one, so the chart shows
            // where the stop was lifted rather than a diagonal smear.
            line.set_x2(p.lnStop, bar_index)
            p.lnStop := line.new(bar_index, newStop, bar_index + 1, newStop, color = cStop, width = 2)
        else
            line.set_y1(p.lnStop, newStop)
            line.set_y2(p.lnStop, newStop)

method carry(Position p) =>
    if drawLevels
        line.set_x2(p.lnFill, bar_index)
        line.set_x2(p.lnStop, bar_index)
        line.set_x2(p.lnT1,   bar_index)
        line.set_x2(p.lnT2,   bar_index)


// ═══ STATE ═══════════════════════════════════════════════════════════════════

var shelves = array.new<Shelf>()
var watches = array.new<Watch>()
var Position P = na

var int   tradeCount = 0
var int   winCount   = 0
var int   lossCount  = 0
var int   flatCount  = 0
var float rTotal     = 0.0
var float rBest      = 0.0
var float rWorst     = 0.0

markLong  = false
markShort = false
markExit  = false


// ═══ SHELF INTAKE ════════════════════════════════════════════════════════════

record(float px, int atBar) =>
    if not na(px) and ready
        absorbed = false
        if array.size(shelves) > 0
            for i = 0 to array.size(shelves) - 1
                s = array.get(shelves, i)
                if math.abs(s.px - px) <= fuseAtr * atr
                    s.tests := s.tests + 1
                    absorbed := true
                    break
        if not absorbed
            ln = drawShelves ? line.new(atBar, px, bar_index, px, color = cShelf, style = line.style_dotted) : line(na)
            array.push(shelves, Shelf.new(px, atBar, 1, close > px ? 1 : -1, 0, -100000, ln))
            if array.size(shelves) > shelfCap
                stale = array.shift(shelves)
                line.delete(stale.ln)


// ═══ ENGINE ══════════════════════════════════════════════════════════════════

if barstate.isconfirmed and ready

    // ── Intake ───────────────────────────────────────────────────────────────
    if not na(pivotHi)
        record(pivotHi, bar_index - pivotR)
    if not na(pivotLo)
        record(pivotLo, bar_index - pivotR)
    if useHTF and dayTurned
        record(prevHigh, bar_index)
        record(prevLow,  bar_index)

    // ── Shelves: age, tests, and the flip that starts a setup ────────────────
    forceOk = hasForce()

    if array.size(shelves) > 0
        for i = array.size(shelves) - 1 to 0
            s = array.get(shelves, i)

            if bar_index - s.born > shelfAge
                line.delete(s.ln)
                array.remove(shelves, i)
                continue

            if drawShelves
                s.stretch()

            nowFacing = close > s.px ? 1 : -1
            if nowFacing == s.facing
                s.settled := s.settled + 1
                if s.pierced()
                    // Pierced but not closed through: the shelf was tested and held.
                    s.tests := s.tests + 1
            else if math.abs(close - s.px) >= clearAtr * atr
                if s.mature() and forceOk
                    s.lastBreak := bar_index
                    bx = drawZones ? box.new(bar_index, s.px + zoneAtr * atr, bar_index + 1, s.px - zoneAtr * atr,
                             border_color = color.new(nowFacing == 1 ? cUp : cDn, 55),
                             bgcolor      = color.new(nowFacing == 1 ? cUp : cDn, 88)) : box(na)
                    array.push(watches, Watch.new(nowFacing, s.px, bar_index, close, false, false, float(na), bx))
                    if array.size(watches) > 6
                        dropped = array.shift(watches)
                        box.delete(dropped.bx)
                s.facing  := nowFacing
                s.settled := 0

    // ── Watches: thrust, pullback, rejection ─────────────────────────────────
    signalWay = 0
    float signalFill = na
    float signalStop = na
    float signalLeg  = na

    if array.size(watches) > 0
        for i = array.size(watches) - 1 to 0
            w    = array.get(watches, i)
            d    = w.way
            done = false

            w.advance()

            if w.expired()
                done := true
            else if w.thrust and bar_index - w.born >= waitMin
                if not w.tagged and (d == 1 ? low <= w.zoneHi() : high >= w.zoneLo())
                    w.tagged := true
                    w.pull   := d == 1 ? low : high

                if w.tagged
                    w.pull := d == 1 ? math.min(w.pull, low) : math.max(w.pull, high)
                    if w.rejects()
                        stop = w.proposedStop()
                        risk = (close - stop) * d
                        tooWide = capAtr > 0 and risk > capAtr * atr
                        if risk > 0 and not tooWide
                            signalWay  := d
                            signalFill := close
                            signalStop := stop
                            signalLeg  := math.abs(w.reach - w.px)
                            done       := true

            if done
                box.delete(w.bx)
                array.remove(watches, i)

    // ── The open position, resolved before anything new is taken ─────────────
    if not na(P)
        d = P.way
        float outPx = na
        string outWhy = ""

        // Conservative intrabar assumption: when one bar spans both the stop
        // and a target, the stop is assumed to have filled first.
        stopHit = d == 1 ? low  <= P.stop : high >= P.stop
        t1Hit   = not P.scaled and (d == 1 ? high >= P.t1 : low <= P.t1)
        t2Hit   = d == 1 ? high >= P.t2 : low  <= P.t2

        if stopHit
            outPx  := P.stop
            outWhy := P.scaled and liftToBE ? "BE" : "STOP"
        else
            if t1Hit
                P.scaled := true
                if drawTags and scalePc > 0
                    label.new(bar_index, P.t1, str.format("T1 +{0,number,#.##}R · {1,number,#}%", r1, scalePc),
                         style = d == 1 ? label.style_label_down : label.style_label_up,
                         color = color.new(cTgt, 25), textcolor = color.white, size = size.tiny)
                if liftToBE
                    P.reprice(P.fill + d * bePad * atr, true)

            if trailPvt and P.scaled
                anchor = d == 1 ? swingLo : swingHi
                if not na(anchor)
                    lifted = anchor - d * padAtr * atr
                    if (lifted - P.stop) * d > 0 and (close - lifted) * d > 0
                        P.reprice(lifted, false)

            if t2Hit
                outPx  := P.t2
                outWhy := "TARGET"
            else if holdMax > 0 and bar_index - P.opened >= holdMax
                outPx  := close
                outWhy := "TIME"

        P.carry()

        if not na(outPx)
            closedR = (outPx - P.fill) * d / P.risk
            part    = scalePc / 100.0
            netR    = P.scaled ? part * r1 + (1 - part) * closedR : closedR

            tradeCount += 1
            rTotal     += netR
            rBest      := math.max(rBest, netR)
            rWorst     := math.min(rWorst, netR)
            if netR > 0.05
                winCount += 1
            else if netR < -0.05
                lossCount += 1
            else
                flatCount += 1

            if drawTags
                label.new(bar_index, outPx,
                     str.format("EXIT {0}\n{1}{2,number,#.##}R", outWhy, netR >= 0 ? "+" : "", netR),
                     style     = d == 1 ? label.style_label_down : label.style_label_up,
                     color     = color.new(netR > 0.05 ? cTgt : cStop, 15),
                     textcolor = color.white, size = size.small)
            if drawLevels and not na(P.lnFill)
                line.set_style(P.lnFill, line.style_solid)
                line.set_color(P.lnFill, color.new(color.gray, 40))

            alert(str.format("{0} EXIT {1} @ {2} → {3}R", d == 1 ? "LONG" : "SHORT", outWhy,
                 str.tostring(outPx, format.mintick), str.tostring(netR, "#.##")), alert.freq_once_per_bar)
            markExit := true
            P := na

    // ── Take the signal ──────────────────────────────────────────────────────
    if signalWay != 0 and (not solo or na(P))
        d    = signalWay
        risk = (signalFill - signalStop) * d
        t1   = signalFill + d * r1 * risk
        float t2 = t2Mode == "R multiple" ? signalFill + d * r2 * risk : signalFill + d * legMult * signalLeg
        // A projected leg that lands short of the first target is not a target.
        t2 := d == 1 ? math.max(t2, t1 + 0.5 * risk) : math.min(t2, t1 - 0.5 * risk)
        rr = (t2 - signalFill) * d / risk

        if rr >= minRR
            lnF = drawLevels ? line.new(bar_index, signalFill, bar_index + 1, signalFill, color = color.new(color.gray, 20), style = line.style_dashed) : line(na)
            lnS = drawLevels ? line.new(bar_index, signalStop, bar_index + 1, signalStop, color = cStop, width = 2) : line(na)
            ln1 = drawLevels ? line.new(bar_index, t1, bar_index + 1, t1, color = color.new(cTgt, 45), style = line.style_dotted) : line(na)
            ln2 = drawLevels ? line.new(bar_index, t2, bar_index + 1, t2, color = cTgt, width = 2) : line(na)
            P := Position.new(d, signalFill, risk, signalStop, t1, t2, bar_index, false, lnF, lnS, ln1, ln2)

            units = riskPct > 0 and syminfo.pointvalue > 0 ? equity * riskPct / 100.0 / (risk * syminfo.pointvalue) : na
            if drawTags
                label.new(bar_index, d == 1 ? low : high,
                     str.format("{0} @ {1}\nstop {2} · target {3}\n{4,number,#.##}R{5}",
                          d == 1 ? "▲ LONG" : "▼ SHORT",
                          str.tostring(signalFill, format.mintick),
                          str.tostring(signalStop, format.mintick),
                          str.tostring(t2, format.mintick),
                          rr,
                          na(units) ? "" : str.format(" · {0,number,#.##} units", units)),
                     style     = d == 1 ? label.style_label_up : label.style_label_down,
                     color     = color.new(d == 1 ? cUp : cDn, 12),
                     textcolor = color.white, size = size.small)

            markLong  := d == 1
            markShort := d == -1
            alert(str.format("{0} ENTRY @ {1} | stop {2} | T1 {3} | T2 {4} | {5}R",
                 d == 1 ? "LONG" : "SHORT",
                 str.tostring(signalFill, format.mintick),
                 str.tostring(signalStop, format.mintick),
                 str.tostring(t1, format.mintick),
                 str.tostring(t2, format.mintick),
                 str.tostring(rr, "#.##")), alert.freq_once_per_bar)


// ═══ MARKERS AND ALERTS ══════════════════════════════════════════════════════

plotshape(markLong,  "Long entry",  style = shape.triangleup,   location = location.belowbar, color = cUp, size = size.small)
plotshape(markShort, "Short entry", style = shape.triangledown, location = location.abovebar, color = cDn, size = size.small)
plotshape(markExit,  "Exit",        style = shape.xcross,       location = location.top,      color = color.new(color.orange, 0), size = size.tiny)

alertcondition(markLong,  "Breakout retest — long entry",  "Breakout retest LONG entry on {{ticker}}")
alertcondition(markShort, "Breakout retest — short entry", "Breakout retest SHORT entry on {{ticker}}")
alertcondition(markExit,  "Breakout retest — exit",        "Breakout retest position closed on {{ticker}}")


// ═══ SUMMARY PANEL ═══════════════════════════════════════════════════════════
//
//  These are on-chart bookkeeping, not a backtest. Fills are assumed at the
//  exact stop and target prices, there is no slippage and no commission, and a
//  bar containing both the stop and a target is scored as a stop. Read it to
//  compare one set of settings against another — not as a performance record.

panelSlot() =>
    out = position.top_right
    if panelWhere == "Top left"
        out := position.top_left
    else if panelWhere == "Bottom right"
        out := position.bottom_right
    else if panelWhere == "Bottom left"
        out := position.bottom_left
    out

var table panel = na
if drawPanel and barstate.islast
    if na(panel)
        panel := table.new(panelSlot(), 2, 8,
             bgcolor      = color.new(color.black, 80),
             border_color = color.new(color.gray, 55), border_width = 1,
             frame_color  = color.new(color.gray, 40), frame_width  = 1)

    hitRate = tradeCount > 0 ? 100.0 * winCount / tradeCount : 0.0
    rAvg    = tradeCount > 0 ? rTotal / tradeCount : 0.0

    // Resolved before the table calls: reading a field off an na object is a
    // runtime error, and a ternary is not a safe guard against it.
    string openTxt = "flat"
    color  openCol = color.silver
    if not na(P)
        openTxt := str.format("{0} @ {1}", P.way == 1 ? "LONG" : "SHORT", str.tostring(P.fill, format.mintick))
        openCol := P.way == 1 ? cUp : cDn

    table.cell(panel, 0, 0, "BREAKOUT RETEST", text_color = color.white, text_size = size.small, bgcolor = color.new(color.gray, 60))
    table.cell(panel, 1, 0, str.tostring(tradeCount) + " trades", text_color = color.white, text_size = size.small, bgcolor = color.new(color.gray, 60))
    table.cell(panel, 0, 1, "Hit rate", text_color = color.silver, text_size = size.small)
    table.cell(panel, 1, 1, str.tostring(hitRate, "#.#") + "%", text_color = hitRate >= 50 ? cTgt : color.white, text_size = size.small)
    table.cell(panel, 0, 2, "Win / loss / flat", text_color = color.silver, text_size = size.small)
    table.cell(panel, 1, 2, str.format("{0} / {1} / {2}", winCount, lossCount, flatCount), text_color = color.white, text_size = size.small)
    table.cell(panel, 0, 3, "Net R", text_color = color.silver, text_size = size.small)
    table.cell(panel, 1, 3, str.tostring(rTotal, "#.##") + "R", text_color = rTotal >= 0 ? cTgt : cStop, text_size = size.small)
    table.cell(panel, 0, 4, "Average R", text_color = color.silver, text_size = size.small)
    table.cell(panel, 1, 4, str.tostring(rAvg, "#.##") + "R", text_color = rAvg >= 0 ? cTgt : cStop, text_size = size.small)
    table.cell(panel, 0, 5, "Best / worst", text_color = color.silver, text_size = size.small)
    table.cell(panel, 1, 5, str.format("{0,number,#.##} / {1,number,#.##}", rBest, rWorst), text_color = color.white, text_size = size.small)
    table.cell(panel, 0, 6, "Setups pending", text_color = color.silver, text_size = size.small)
    table.cell(panel, 1, 6, str.tostring(array.size(watches)), text_color = color.white, text_size = size.small)
    table.cell(panel, 0, 7, "Position", text_color = color.silver, text_size = size.small)
    table.cell(panel, 1, 7, openTxt, text_color = openCol, text_size = size.small)
